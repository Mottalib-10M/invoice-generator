---
/**
 * Folded quotable block (RECETTE §26, 2026-10-02): ONE <p> in the HTML, whole. The screen shows the
 * first whole sentence; the rest sits in a hidden <span> of the same <p>, unfolded by a checkbox, no
 * JavaScript. Never a cut mid-sentence, never a <details>: check-seo must find the 120-word block in
 * the first 30 % of the page (§21).
 */
import { t } from '../i18n/ui';
import type { Locale } from '../i18n/routes';
interface Props { text: string; lang: Locale; id: string; sentences?: number; class?: string }
const { text, lang, id, sentences = 1, class: cls = '' } = Astro.props;
// Cut between two sentences: final punctuation, space, capital letter. "5.5 %" does not cut.
const parts = text.split(/(?<=[.!?])\s+(?=\p{Lu})/u);
const head = parts.slice(0, sentences).join(' ').trim();
const rest = parts.slice(sentences).join(' ').trim();
---
<div class={`clamp ${cls}`}>
  {rest && <input type="checkbox" id={id} class="clamp-toggle" />}
  <p class="text-navy-800">{head}{rest && <span class="clamp-rest"> {rest}</span>}</p>
  {rest && <label for={id} class="clamp-more">{t(lang).readMore}</label>}
</div>
